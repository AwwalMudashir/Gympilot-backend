DB_URL=jdbc:postgresql://localhost:5432/gympilot
DB_USERNAME=gympilot
DB_PASSWORD=replace-with-your-local-database-password
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ISSUER=gympilot-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFICATION_HOURS=24
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://10.0.2.2:8081
FRONTEND_BASE_URL=gymbro://auth
EXPOSE_DEVELOPMENT_TOKENS=false
APP_TIME_ZONE=Africa/Lagos

# Cloudinary (never commit real credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gympilot
CLOUDINARY_MAX_IMAGE_BYTES=5242880

# Brevo transactional email (never commit the real API key)
EMAIL_DELIVERY_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GymBro
BREVO_BASE_URL=https://api.brevo.com/v3

# Local Ollama plan explanations
PLAN_EXPLANATION_AI_ENABLED=false
SPRING_AI_CHAT_MODEL=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.2
